# =============================================================================
# Saltwise - Environment Variables Template
# Copy to .env (and apps/web/.env + packages/db/.env) and fill in values
# =============================================================================

# --- Supabase (single project for DB + Auth + Vector) ---
# All three values come from the SAME Supabase project.
# No separate "vector" project/keys needed — pg_trgm / pgvector are
# Postgres extensions on the same DB.
# - DATABASE_URL:    Project Settings -> Database -> Connection string -> Transaction pooler (port 6543, ?pgbouncer=true)
#                    Used by @saltwise/db and drizzle-kit
#                    packages/db/src/env.ts:6, packages/db/drizzle.config.ts:3, apps/web/lib/env.ts:8
# - NEXT_PUBLIC_SUPABASE_URL / ANON_KEY: Project Settings -> API Keys
#                    Used by @supabase/ssr client/server + proxy
#                    apps/web/lib/env.ts:11-12, apps/web/lib/supabase/client.ts:6, proxy.ts:9
# After creating the project, run in SQL Editor:
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;   -- required for similarity() fuzzy search (apps/web/lib/firecrawl/service.ts:301)
#   CREATE EXTENSION IF NOT EXISTS vector;    -- only if you add vector columns later (not used yet)
#   CREATE EXTENSION IF NOT EXISTS pgcrypto;  -- for gen_random_uuid()
DATABASE_URL="postgresql://postgres.your-ref:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
NEXT_PUBLIC_SUPABASE_URL="https://your-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Groq (required) ---
# AI inference - used by apps/web/lib/ai/groq.ts:33
# Get from https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# --- Deepgram (required) ---
# TTS/STT - used by apps/web/lib/ai/deepgram.ts:31 and deepgram-streaming.ts:98
# Get from https://console.deepgram.com/
DEEPGRAM_API_KEY="your-deepgram-api-key"

# --- Firecrawl (optional but required for external medicine search) ---
# Web scraping/search - used by apps/web/lib/firecrawl/service.ts:11
# Get from https://www.firecrawl.dev/
# If empty, search falls back to DB-only results
FIRECRAWL_API_KEY="fc-..."
