# Copy to .env and fill in values
# Same Supabase project as apps/web (DB + Auth + Vector = same Postgres)
# Use Transaction Pooler URI (6543, ?pgbouncer=true) - see root .env.example
# See packages/db/src/env.ts:6 and drizzle.config.ts:3

DATABASE_URL="postgresql://postgres.your-ref:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
